generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  email            String         @unique
  password         String
  name             String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  id               Int            @id @default(autoincrement())
  resetToken       String?        @map("reset_token")
  resetTokenExpiry DateTime?      @map("reset_token_expiry")
  isActive         Boolean        @default(true) @map("is_active")
  roleId           Int?           @map("role_id")
  refreshTokens    RefreshToken[]
  role             Role?          @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true) @map("is_active")
  users       User[]

  @@map("roles")
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  userId     Int      @map("user_id")
  deviceInfo String?  @map("device_info")
  ipAddress  String?  @map("ip_address")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Category {
  name      String    @unique
  hsnCode   String    @unique @map("hsn_code")
  gstRate   Float     @map("gst_rate")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  id        Int       @id @default(autoincrement())
  products  Product[]

  @@map("categories")
}

model Product {
  name               String
  grade              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  id                 Int                 @id @default(autoincrement())
  categoryId         Int                 @map("category_id")
  description        String?
  sku                String?             @unique
  upc                String?             @unique
  brand              String?
  color              String?
  boxDetails         BoxDetail[]
  inwardItems        InwardItem[]
  outwardItems       OutwardItem[]
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  purchaseOrderItems PurchaseOrderItem[] @relation("PurchaseOrderItems")
  quoteItems         QuoteItem[]
  salesOrderItems    SalesOrderItem[]
  sampleItems        SampleItem[]
  stockBatches       StockBatch[]

  @@unique([name, grade])
  @@map("products")
}

model Vendor {
  code           String          @unique
  name           String
  email          String?
  phone          String?
  address        String?
  state          String?
  gstNumber      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  id             Int             @id @default(autoincrement())
  inwardInvoices InwardInvoice[]
  purchaseOrders PurchaseOrder[] @relation("PurchaseOrders")
  stockBatches   StockBatch[]
  paymentsMade   PaymentMade[]

  @@map("vendors")
}

model Customer {
  code            String           @unique
  name            String
  email           String?
  phone           String?
  address         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  id              Int              @id @default(autoincrement())
  gstNumber       String?          @map("gst_number")
  state           String?
  shippingAddress String?          @map("shipping_address")
  outwardInvoices   OutwardInvoice[]
  quotes            Quote[]
  salesOrders       SalesOrder[]
  paymentsReceived  PaymentReceived[]

  @@map("customers")
}

model Location {
  name           String          @unique
  address        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  id             Int             @id @default(autoincrement())
  inwardInvoices InwardInvoice[]
  outwardItems   OutwardItem[]
  stockBatches   StockBatch[]

  @@map("locations")
}

model InwardInvoice {
  invoiceNo  String       @unique @map("invoice_no")
  date       DateTime
  totalCost  Float        @map("total_cost")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  id         Int          @id @default(autoincrement())
  vendorId   Int          @map("vendor_id")
  locationId Int          @map("location_id")
  expense    Float        @default(0)
  boxDetails BoxDetail[]
  location   Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  vendor          Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items           InwardItem[]
  amountPaid      Float                @default(0) @map("amount_paid")
  paymentsApplied PaymentMadeInvoice[]

  @@index([vendorId])
  @@map("inward_invoices")
}

model InwardItem {
  boxes           Int
  totalPcs        Int           @map("total_pcs")
  ratePerBox      Float         @map("rate_per_box")
  ratePerPcs      Float         @map("rate_per_pcs")
  gstAmount       Float         @map("gst_amount")
  totalCost       Float         @map("total_cost")
  packPerBox      Int           @map("pack_per_box")
  packPerPiece    Int           @map("pack_per_piece")
  ratePerPack     Float         @map("rate_per_pack")
  totalPacks      Int           @map("total_packs")
  id              Int           @id @default(autoincrement())
  inwardInvoiceId Int           @map("inward_invoice_id")
  productId       Int           @map("product_id")
  unit            String        @default("box")
  parentItemId    Int?          @map("parent_item_id")
  batchCode       String?       @map("batch_code")
  mfgDate         DateTime?     @map("mfg_date")
  color           String?
  brand           String?
  inwardInvoice   InwardInvoice @relation(fields: [inwardInvoiceId], references: [id], onDelete: Cascade)
  parentItem      InwardItem?   @relation("SubItems", fields: [parentItemId], references: [id], onDelete: Cascade)
  subItems        InwardItem[]  @relation("SubItems")
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inward_items")
}

model OutwardInvoice {
  invoiceNo             String           @unique @map("invoice_no")
  date                  DateTime
  saleType              String           @map("sale_type")
  expense               Float            @default(0)
  totalCost             Float            @map("total_cost")
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  id                    Int              @id @default(autoincrement())
  customerId            Int              @map("customer_id")
  isIncludeInProfitLoss Boolean          @default(true) @map("is_include_in_profit_loss")
  adjustment            Float            @default(0)
  amountReceived        Float            @default(0) @map("amount_received")
  referenceNo           String?          @map("reference_no")
  shippingCharge        Float            @default(0) @map("shipping_charge")
  discount              Float            @default(0)
  boxDetails            BoxDetail[]
  customer              Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items                 OutwardItem[]
  paymentsApplied       PaymentReceivedInvoice[]

  @@index([customerId])
  @@map("outward_invoices")
}

model OutwardItem {
  saleUnit         String         @map("sale_unit")
  quantity         Int
  ratePerUnit      Float          @map("rate_per_unit")
  totalCost        Float          @map("total_cost")
  id               Int            @id @default(autoincrement())
  outwardInvoiceId Int            @map("outward_invoice_id")
  productId        Int            @map("product_id")
  stockBatchId     Int            @map("stock_batch_id")
  locationId       Int            @map("location_id")
  description      String?
  location         Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  outwardInvoice   OutwardInvoice @relation(fields: [outwardInvoiceId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockBatch       StockBatch     @relation(fields: [stockBatchId], references: [id], onDelete: Cascade)

  @@map("outward_items")
}

model StockBatch {
  inwardDate      DateTime      @map("inward_date")
  boxes           Int
  totalPcs        Int           @map("total_pcs")
  remainingBoxes  Int           @map("remaining_boxes")
  remainingPcs    Int           @map("remaining_pcs")
  costPerBox      Float         @map("cost_per_box")
  costPerPcs      Float         @map("cost_per_pcs")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  costPerPack     Float         @map("cost_per_pack")
  packPerBox      Int           @map("pack_per_box")
  packPerPiece    Int           @map("pack_per_piece")
  remainingPacks  Int           @map("remaining_packs")
  totalPacks      Int           @map("total_packs")
  id              Int           @id @default(autoincrement())
  productId       Int           @map("product_id")
  vendorId        Int           @map("vendor_id")
  locationId      Int           @map("location_id")
  inwardInvoiceId Int?          @map("inward_invoice_id")
  batchCode       String?       @map("batch_code")
  mfgDate         DateTime?     @map("mfg_date")
  boxDetails      BoxDetail[]
  outwardItems    OutwardItem[]
  location        Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor          Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("stock_batches")
}

model StockMovement {
  type         String
  quantity     Int
  movementDate DateTime @map("movement_date")
  createdAt    DateTime @default(now())
  id           Int      @id @default(autoincrement())
  referenceId  Int      @map("reference_id")
  productId    Int      @map("product_id")
  locationId   Int      @map("location_id")

  @@map("stock_movements")
}

model StockTransfer {
  id             Int      @id @default(autoincrement())
  transferNo     String   @unique @map("transfer_no")
  stockBatchId   Int      @map("stock_batch_id")
  fromLocationId Int      @map("from_location_id")
  toLocationId   Int      @map("to_location_id")
  boxes          Int
  packs          Int      @default(0)
  pieces         Int      @default(0)
  transferDate   DateTime @map("transfer_date")
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("stock_transfers")
}

model Sample {
  id              Int          @id @default(autoincrement())
  sampleNo        String       @unique @map("sample_no")
  sentDate        DateTime     @default(now()) @map("sent_date")
  status          String       @default("pending")
  remarks         String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  customerAddress String?      @map("customer_address")
  customerEmail   String?      @map("customer_email")
  customerName    String       @map("customer_name")
  customerPhone   String?      @map("customer_phone")
  dispatchMethod  String       @default("courier") @map("dispatch_method")
  kitPrice        Float        @default(0) @map("kit_price")
  sampleType      String       @default("domestic") @map("sample_type")
  sentBy          String?      @map("sent_by")
  trackingNumber  String?      @map("tracking_number")
  gstNumber       String?      @map("gst_number")
  invoiceNumber   String?      @map("invoice_number")
  orderId         String?      @map("order_id")
  panNumber       String?      @map("pan_number")
  paymentId       String?      @map("payment_id")
  products        String?      @map("products")
  source          String       @default("manual") @map("source")
  state           String?      @map("state")
  subtotal        Float?       @map("subtotal")
  tax             Float?       @map("tax")
  userType        String?      @map("user_type")
  items           SampleItem[]

  @@map("samples")
}

model SampleItem {
  id        Int     @id @default(autoincrement())
  sampleId  Int     @map("sample_id")
  productId Int     @map("product_id")
  quantity  Int
  unit      String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sample    Sample  @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  @@map("sample_items")
}

model Quote {
  id                 Int          @id @default(autoincrement())
  quoteNo            String       @unique @map("quote_no")
  customerId         Int          @map("customer_id")
  quoteDate          DateTime     @map("quote_date")
  expiryDate         DateTime     @map("expiry_date")
  status             String       @default("draft")
  totalAmount        Float        @map("total_amount")
  discount           Float        @default(0)
  tax                Float        @default(0)
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  termsAndConditions String?      @map("terms_and_conditions")
  paymentTerms       String?      @map("payment_terms")
  reference          String?
  termsOfDelivery    String?      @map("terms_of_delivery")
  shippingCharge     Float        @default(0) @map("shipping_charge")
  adjustment         Float        @default(0)
  items              QuoteItem[]
  customer           Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salesOrders        SalesOrder[]

  @@index([customerId])
  @@map("quotes")
}

model QuoteItem {
  id          Int     @id @default(autoincrement())
  quoteId     Int     @map("quote_id")
  productId   Int     @map("product_id")
  quantity    Int
  unit        String
  rate        Float
  amount      Float
  description String?
  taxRate     Float   @default(0) @map("tax_rate")
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("quote_items")
}

model SalesOrder {
  id                   Int              @id @default(autoincrement())
  orderNo              String           @unique @map("order_no")
  quoteId              Int?             @map("quote_id")
  customerId           Int              @map("customer_id")
  orderDate            DateTime         @map("order_date")
  status               String           @default("pending")
  saleType             String           @default("domestic") @map("sale_type")
  totalAmount          Float            @default(0) @map("total_amount")
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deliveryMethod       String?          @map("delivery_method")
  expectedShipmentDate DateTime?        @map("expected_shipment_date")
  placeOfSupply        String?          @map("place_of_supply")
  reference            String?
  adjustment           Float            @default(0)
  amountReceived       Float            @default(0) @map("amount_received")
  shippingCharge       Float            @default(0) @map("shipping_charge")
  discount             Float            @default(0)
  referenceBy          String?          @map("reference_by")
  dispatch             OrderDispatch?
  items                SalesOrderItem[]
  customer             Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quote                Quote?           @relation(fields: [quoteId], references: [id])

  @@index([customerId])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           Int        @id @default(autoincrement())
  salesOrderId Int        @map("sales_order_id")
  productId    Int        @map("product_id")
  quantity     Int
  unit         String
  rate         Float
  taxRate      Float      @default(0) @map("tax_rate")
  amount       Float
  description  String?
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@map("sales_order_items")
}

model WebsiteQuote {
  id                     Int      @id @default(autoincrement())
  quoteNo                String   @unique @map("quote_no")
  companyName            String   @map("company_name")
  contactPerson          String?  @map("contact_person")
  email                  String?
  mobile                 String?
  orderType              String   @default("domestic") @map("order_type")
  gstin                  String?
  city                   String?
  state                  String?
  pincode                String?
  billingAddress         String?  @map("billing_address")
  country                String?
  deliveryTerms          String?  @map("delivery_terms")
  portOfDischarge        String?  @map("port_of_discharge")
  address                String?
  additionalRequirements String?  @map("additional_requirements")
  totalPieces            Int      @default(0) @map("total_pieces")
  totalWeight            String?  @map("total_weight")
  totalCBM               String?  @map("total_cbm")
  products               String
  quoteDate              DateTime @default(now()) @map("quote_date")
  status                 String   @default("new")
  remarks                String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  discount               Float    @default(0)
  notes                  String?
  paymentTerms           String?  @map("payment_terms")
  prices                 String?
  shippingCharge         Float    @default(0) @map("shipping_charge")
  tax                    Float    @default(0)
  termsAndConditions     String?  @map("terms_and_conditions")
  termsOfDelivery        String?  @map("terms_of_delivery")

  @@map("website_quotes")
}

model Lead {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  company   String?
  country   String?
  message   String?
  formType  String   @map("form_type")
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  source    String   @default("website")

  @@map("leads")
}

model OrderDispatch {
  id                Int        @id @default(autoincrement())
  dispatchNo        String     @unique @map("dispatch_no")
  salesOrderId      Int        @unique @map("sales_order_id")
  dispatchDate      DateTime   @map("dispatch_date")
  status            String     @default("pending")
  shippingMethod    String     @map("shipping_method")
  trackingNumber    String?    @map("tracking_number")
  carrier           String?
  estimatedDelivery DateTime?  @map("estimated_delivery")
  actualDelivery    DateTime?  @map("actual_delivery")
  shippingAddress   String     @map("shipping_address")
  shippingCity      String     @map("shipping_city")
  shippingState     String     @map("shipping_state")
  shippingPincode   String     @map("shipping_pincode")
  shippingCountry   String     @default("India") @map("shipping_country")
  weight            Float?
  dimensions        String?
  packageCount      Int        @default(1) @map("package_count")
  shippingCost      Float      @default(0) @map("shipping_cost")
  insuranceAmount   Float      @default(0) @map("insurance_amount")
  notes             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  toTheOrder        Boolean    @default(false) @map("to_the_order")
  airlineCode       String?    @map("airline_code")
  containerNumber   String?    @map("container_number")
  courierName       String?    @map("courier_name")
  courierPhone      String?    @map("courier_phone")
  driverName        String?    @map("driver_name")
  driverPhone       String?    @map("driver_phone")
  flightNumber      String?    @map("flight_number")
  portOfDischarge   String?    @map("port_of_discharge")
  portOfLoading     String?    @map("port_of_loading")
  truckNumber       String?    @map("truck_number")
  vesselName        String?    @map("vessel_name")
  salesOrder        SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@map("order_dispatches")
}

model Settings {
  id             Int      @id @default(autoincrement())
  companyName    String   @map("company_name")
  companyAddress String   @map("company_address")
  companyPhone   String   @map("company_phone")
  companyEmail   String   @map("company_email")
  companyWebsite String?  @map("company_website")
  companyGstin   String   @map("company_gstin")
  bankName       String   @map("bank_name")
  accountNumber  String   @map("account_number")
  ifscCode       String   @map("ifsc_code")
  bankAddress    String   @map("bank_address")
  swiftCode      String?  @map("swift_code")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("settings")
}

model PurchaseOrder {
  id                 Int                 @id @default(autoincrement())
  poNo               String              @unique @map("po_no")
  vendorId           Int                 @map("vendor_id")
  poDate             DateTime            @map("po_date")
  expectedDelivery   DateTime?           @map("expected_delivery")
  status             String              @default("draft")
  totalAmount        Float               @default(0) @map("total_amount")
  discount           Float               @default(0)
  tax                Float               @default(0)
  notes              String?
  termsAndConditions String?             @map("terms_and_conditions")
  paymentTerms       String?             @map("payment_terms")
  deliveryTerms      String?             @map("delivery_terms")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  reference          String?
  boxDetails         BoxDetail[]
  items              PurchaseOrderItem[]
  vendor             Vendor              @relation("PurchaseOrders", fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              Int                  @id @default(autoincrement())
  purchaseOrderId Int                  @map("purchase_order_id")
  productId       Int                  @map("product_id")
  quantity        Int
  unit            String
  rate            Float
  taxRate         Float                @default(0) @map("tax_rate")
  amount          Float
  description     String?
  boxes           Int                  @default(1)
  packPerBox      Int                  @default(28)
  packPerPiece    Int                  @default(25)
  totalPacks      Int                  @default(28)
  totalPcs        Int                  @default(700)
  ratePerBox      Float                @default(0)
  ratePerPack     Float                @default(0)
  ratePerPcs      Float                @default(0)
  batchCode       String?
  mfgDate         DateTime?
  color           String?
  brand           String?
  parentItemId    Int?                 @map("parent_item_id")
  parentItem      PurchaseOrderItem?   @relation("PurchaseOrderSubItems", fields: [parentItemId], references: [id], onDelete: Cascade)
  subItems        PurchaseOrderItem[]  @relation("PurchaseOrderSubItems")
  product         Product              @relation("PurchaseOrderItems", fields: [productId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}


model BoxDetail {
  id               Int             @id @default(autoincrement())
  barcode          String          @unique
  productId        Int             @map("product_id")
  stockBatchId     Int?            @map("stock_batch_id")
  purchaseOrderId  Int?            @map("purchase_order_id")
  inwardInvoiceId  Int?            @map("inward_invoice_id")
  outwardInvoiceId Int?            @map("outward_invoice_id")
  boxIndex         Int             @map("box_index")
  totalBoxes       Int             @map("total_boxes")
  packPerBox       Int             @map("pack_per_box")
  packPerPiece     Int             @map("pack_per_piece")
  totalPcs         Int             @map("total_pcs")
  status           String          @default("expected")
  batchCode        String?         @map("batch_code")
  mfgDate          DateTime?       @map("mfg_date")
  color            String?
  brand            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  inwardInvoice    InwardInvoice?  @relation(fields: [inwardInvoiceId], references: [id])
  outwardInvoice   OutwardInvoice? @relation(fields: [outwardInvoiceId], references: [id])
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseOrder    PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])
  stockBatch       StockBatch?     @relation(fields: [stockBatchId], references: [id])

  @@map("box_details")
}

model PaymentReceived {
  id              Int                      @id @default(autoincrement())
  paymentNumber   String                   @unique @map("payment_number")
  customerId      Int                      @map("customer_id")
  amount          Float
  date            DateTime
  paymentMode     String                   @map("payment_mode")
  referenceNumber String?                  @map("reference_number")
  depositTo       String                   @map("deposit_to")
  bankCharges     Float                    @default(0) @map("bank_charges")
  taxRate         Float                    @default(0) @map("tax_rate")
  notes           String?
  transactionType String                   @default("invoice_payment") @map("transaction_type")
  unusedAmount    Float                    @default(0) @map("unused_amount")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  customer        Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoices        PaymentReceivedInvoice[]

  @@index([customerId])
  @@map("payments_received")
}

model PaymentReceivedInvoice {
  id                Int             @id @default(autoincrement())
  paymentReceivedId Int             @map("payment_received_id")
  invoiceId         Int             @map("invoice_id")
  amountApplied     Float           @map("amount_applied")
  paymentReceived   PaymentReceived @relation(fields: [paymentReceivedId], references: [id], onDelete: Cascade)
  invoice           OutwardInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([paymentReceivedId, invoiceId])
  @@map("payment_received_invoices")
}

model PaymentMade {
  id              Int                  @id @default(autoincrement())
  paymentNumber   String               @unique @map("payment_number")
  vendorId        Int                  @map("vendor_id")
  amount          Float
  date            DateTime
  paymentMode     String               @map("payment_mode")
  referenceNumber String?              @map("reference_number")
  paidThrough     String               @map("paid_through")
  bankCharges     Float                @default(0) @map("bank_charges")
  notes           String?
  transactionType String               @default("bill_payment") @map("transaction_type")
  unusedAmount    Float                @default(0) @map("unused_amount")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  vendor          Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  invoices        PaymentMadeInvoice[]

  @@index([vendorId])
  @@map("payments_made")
}

model PaymentMadeInvoice {
  id            Int           @id @default(autoincrement())
  paymentMadeId Int           @map("payment_made_id")
  invoiceId     Int           @map("invoice_id")
  amountApplied Float         @map("amount_applied")
  paymentMade   PaymentMade   @relation(fields: [paymentMadeId], references: [id], onDelete: Cascade)
  invoice       InwardInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([paymentMadeId, invoiceId])
  @@map("payment_made_invoices")
}