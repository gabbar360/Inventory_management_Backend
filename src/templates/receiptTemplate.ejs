<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Payment Receipt - <%= receipt.receiptNo %></title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Roboto', sans-serif; font-size: 10pt; color: #333; background: #fff; line-height: 1.4; }

        .page {
            width: 210mm;
            min-height: 297mm;
            margin: 0 auto;
            padding: 12mm 15mm;
            background: #fff;
        }

        .receipt-card {
            border: 1.5px solid #bbb;
            border-radius: 8px;
            overflow: hidden;
        }

        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 15px;
            background-color: #f7faf9;
            border-bottom: 1.5px solid #bbb;
        }

        .logo-block {
            width: 100px;
            display: flex;
            align-items: center;
            justify-content: flex-start;
        }
        .logo-block img {
            max-width: 90px;
            max-height: 65px;
            object-fit: contain;
        }

        .company-block {
            flex: 1;
            margin-left: 15px;
        }
        .company-name {
            font-size: 15pt;
            font-weight: 700;
            color: #0f2a24;
            line-height: 1.1;
        }
        .company-info {
            font-size: 8pt;
            color: #555;
            line-height: 1.4;
            margin-top: 3px;
        }

        .title-block {
            text-align: right;
            flex-shrink: 0;
        }
        .title-text {
            font-size: 16pt;
            font-weight: 700;
            color: #0f2a24;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }
        .receipt-badge {
            display: inline-block;
            margin-top: 4px;
            background-color: #0f2a24;
            color: white;
            font-size: 7.5pt;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 4px;
            text-transform: uppercase;
        }

        .meta-row {
            display: flex;
            border-bottom: 1.5px solid #bbb;
        }
        .meta-left {
            flex: 1.2;
            border-right: 1.5px solid #bbb;
            padding: 10px 15px;
        }
        .meta-right {
            flex: 0.8;
            padding: 10px 15px;
        }

        .meta-table {
            width: 100%;
            border-collapse: collapse;
        }
        .meta-table td {
            padding: 3px 0;
            font-size: 9pt;
            vertical-align: top;
        }
        .meta-table td:first-child {
            color: #666;
            width: 120px;
            font-weight: 500;
        }
        .meta-table td:last-child {
            font-weight: 600;
            color: #111;
        }

        .party-row {
            padding: 12px 15px;
            border-bottom: 1.5px solid #bbb;
            background-color: #fcfcfc;
        }
        .party-label {
            font-size: 8.5pt;
            text-transform: uppercase;
            font-weight: 700;
            color: #666;
            margin-bottom: 4px;
            letter-spacing: 0.5px;
        }
        .party-name {
            font-size: 11pt;
            font-weight: 700;
            color: #111;
        }
        .party-addr {
            font-size: 8.5pt;
            color: #444;
            line-height: 1.4;
            margin-top: 2px;
        }

        .table-section {
            padding: 15px;
        }
        .receipt-table {
            width: 100%;
            border-collapse: collapse;
            border: 1px solid #bbb;
            margin-top: 5px;
        }
        .receipt-table th {
            background-color: #f7faf9;
            color: #0f2a24;
            font-weight: 700;
            font-size: 8.5pt;
            text-transform: uppercase;
            padding: 8px 10px;
            border: 1px solid #bbb;
            text-align: left;
        }
        .receipt-table td {
            padding: 8px 10px;
            font-size: 9pt;
            border: 1px solid #ddd;
            vertical-align: middle;
        }
        .receipt-table td.right, .receipt-table th.right {
            text-align: right;
        }

        .text-bold { font-weight: bold; }
        .amount-highlight {
            font-size: 16pt;
            font-weight: bold;
            color: #0f2a24;
        }

        .words-section {
            margin-top: 10px;
            background-color: #fafafa;
            border: 1px solid #ddd;
            border-radius: 4px;
            padding: 8px 12px;
            font-size: 8.5pt;
            line-height: 1.4;
        }
        .words-label {
            color: #666;
            font-weight: 500;
            margin-bottom: 1px;
        }
        .words-val {
            font-weight: bold;
            color: #111;
        }

        .bottom-section {
            display: flex;
            border-top: 1.5px solid #bbb;
            background-color: #fcfcfc;
            min-height: 110px;
        }
        .bottom-left {
            flex: 1.2;
            padding: 12px 15px;
            border-right: 1.5px solid #bbb;
            font-size: 8pt;
            color: #666;
            display: flex;
            align-items: center;
        }
        .bottom-right {
            flex: 0.8;
            padding: 12px 15px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: flex-end;
            text-align: right;
        }
        .sig-box {
            text-align: center;
            width: 140px;
            border-top: 1px solid #bbb;
            padding-top: 4px;
            font-size: 7.5pt;
            font-weight: bold;
            color: #444;
            margin-top: auto;
        }

        .footer {
            margin-top: 12px;
            text-align: center;
            font-size: 7.5pt;
            color: #aaa;
            border-top: 1px solid #eee;
            padding-top: 5px;
        }
    </style>
</head>
<body>
<div class="page">
    <%
        function fmt(num) {
            if (num === undefined || num === null || isNaN(num)) return '0.00';
            return parseFloat(num).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
        function fmtDate(d) {
            if (!d) return '';
            return new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' });
        }
        
        function numToWords(n) {
            const ones = ['','One','Two','Three','Four','Five','Six','Seven','Eight','Nine'];
            const teens = ['Ten','Eleven','Twelve','Thirteen','Fourteen','Fifteen','Sixteen','Seventeen','Eighteen','Nineteen'];
            const tens = ['','','Twenty','Thirty','Forty','Fifty','Sixty','Seventy','Eighty','Ninety'];
            
            const h = (x) => {
                let r = '';
                if (x >= 100) { r += ones[Math.floor(x/100)] + ' Hundred '; x %= 100; }
                if (x >= 20) { r += tens[Math.floor(x/10)] + ' '; x %= 10; }
                else if (x >= 10) { r += teens[x-10] + ' '; x = 0; }
                if (x > 0) r += ones[x] + ' ';
                return r;
            };
            
            const convertInt = (num) => {
                if (num === 0) return 'Zero';
                let r = '';
                const cr = Math.floor(num/10000000); if (cr) { r += h(cr)+'Crore '; num %= 10000000; }
                const lk = Math.floor(num/100000); if (lk) { r += h(lk)+'Lakh '; num %= 100000; }
                const th = Math.floor(num/1000); if (th) { r += h(th)+'Thousand '; num %= 1000; }
                if (num > 0) r += h(num);
                return r.trim();
            };

            const fixedNum = parseFloat(n).toFixed(2);
            const parts = fixedNum.split('.');
            const rupees = parseInt(parts[0]);
            const paise = parseInt(parts[1]);

            let words = 'INR ' + convertInt(rupees);
            if (paise > 0) {
                words += ' and ' + convertInt(paise) + ' Paise';
            }
            return words + ' Only';
        }

        const invoice = receipt.outwardInvoice;
        
        // Calculate invoice grand total
        let baseCost = 0;
        let gstCost = 0;
        invoice.items?.forEach((item) => {
            const gstRate = item.product?.category?.gstRate || 0;
            const itemBase = item.quantity * item.ratePerUnit;
            const itemGst = (itemBase * gstRate) / 100;
            baseCost += itemBase;
            gstCost += itemGst;
        });

        const expense = invoice.expense || 0;
        const adjustment = invoice.adjustment || 0;
        const shippingCharge = invoice.shippingCharge || 0;
        const invoiceTotal = baseCost + gstCost + expense + shippingCharge - adjustment;
        const balanceDue = invoiceTotal - (invoice.amountReceived || 0);
    %>

    <div class="receipt-card">
        <!-- HEADER -->
        <div class="header">
            <div class="logo-block">
                <% if (logoBase64) { %>
                    <img src="data:image/webp;base64,<%= logoBase64 %>" alt="Logo">
                <% } %>
            </div>
            <div class="company-block">
                <div class="company-name"><%= settings?.companyName || 'Vegnar Global LLP' %></div>
                <div class="company-info">
                    <%= settings?.companyAddress || 'B-623, RK Iconic, 150 Ring Road Ayodhya Chowk\nRajkot Gujarat 360007, India' %><br>
                    GSTIN: <%= settings?.companyGstin || '24ABAFV3901A1ZV' %> | <%= settings?.companyEmail || 'sales@vegnar.com' %>
                </div>
            </div>
            <div class="title-block">
                <div class="title-text">Payment Receipt</div>
                <div class="receipt-badge"><%= receipt.receiptNo %></div>
            </div>
        </div>

        <!-- META -->
        <div class="meta-row">
            <div class="meta-left">
                <table class="meta-table">
                    <tr><td>Receipt Date</td><td><%= fmtDate(receipt.paymentDate) %></td></tr>
                    <tr><td>Payment Method</td><td><%= receipt.paymentMethod %></td></tr>
                    <% if (receipt.transactionId) { %>
                        <tr><td>Transaction ID</td><td><%= receipt.transactionId %></td></tr>
                    <% } %>
                </table>
            </div>
            <div class="meta-right">
                <table class="meta-table">
                    <tr><td>Invoice Ref</td><td><%= invoice.invoiceNo %></td></tr>
                    <tr><td>Invoice Date</td><td><%= fmtDate(invoice.date) %></td></tr>
                </table>
            </div>
        </div>

        <!-- CLIENT BILL TO -->
        <div class="party-row">
            <div class="party-label">Received From</div>
            <div class="party-name"><%= invoice.customer?.name %></div>
            <div class="party-addr">
                <%= invoice.customer?.address || '' %><br>
                <% if (invoice.customer?.phone) { %>Phone: <%= invoice.customer.phone %><br><% } %>
                <% if (invoice.customer?.gstNumber) { %>GSTIN: <%= invoice.customer.gstNumber %><% } %>
            </div>
        </div>

        <!-- PAYMENT TABLE -->
        <div class="table-section">
            <table class="receipt-table">
                <thead>
                    <tr>
                        <th style="width: 50%;">Description</th>
                        <th class="right" style="width: 25%;">Invoice Total</th>
                        <th class="right" style="width: 25%;">Amount Paid</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td style="font-weight: 500; vertical-align: top;">
                            Payment against Tax Invoice <span style="font-weight: bold; color: #0f2a24;"><%= invoice.invoiceNo %></span>
                            <% if (receipt.notes) { %>
                                <div style="font-size: 8pt; color: #666; font-weight: normal; margin-top: 3px; font-style: italic;">
                                    Notes: <%= receipt.notes %>
                                </div>
                            <% } %>

                            <!-- Integrated Chronological Payment History Ledger -->
                            <% if (invoice.paymentReceipts && invoice.paymentReceipts.length > 0) { %>
                            <div style="margin-top: 15px; border-top: 1px dashed #bbb; padding-top: 10px;">
                                <div style="font-size: 8pt; font-weight: 700; color: #0f2a24; text-transform: uppercase; margin-bottom: 6px; letter-spacing: 0.3px;">
                                    Payment Ledger & History
                                </div>
                                <table style="width: 100%; border-collapse: collapse; font-size: 8pt; line-height: 1.4;">
                                    <thead>
                                        <tr style="background-color: #fafafa; border-bottom: 1.5px solid #bbb;">
                                            <th style="padding: 4px 6px; text-align: left; font-size: 7.5pt; font-weight: 700; color: #444; border: 1px solid #ddd;">Receipt No</th>
                                            <th style="padding: 4px 6px; text-align: left; font-size: 7.5pt; font-weight: 700; color: #444; border: 1px solid #ddd;">Date</th>
                                            <th style="padding: 4px 6px; text-align: left; font-size: 7.5pt; font-weight: 700; color: #444; border: 1px solid #ddd;">Method</th>
                                            <th style="padding: 4px 6px; text-align: right; font-size: 7.5pt; font-weight: 700; color: #444; border: 1px solid #ddd;">Amount</th>
                                            <th style="padding: 4px 6px; text-align: right; font-size: 7.5pt; font-weight: 700; color: #444; border: 1px solid #ddd;">Balance</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% 
                                            let runningPaidTotal = 0;
                                            invoice.paymentReceipts.forEach((pr) => {
                                                runningPaidTotal += pr.amount;
                                                const runningBalance = invoiceTotal - runningPaidTotal;
                                                const isCurrentReceipt = pr.id === receipt.id;
                                        %>
                                        <tr style="<%= isCurrentReceipt ? 'background-color: #f0f7f4; font-weight: 600;' : '' %>">
                                            <td style="padding: 4px 6px; border: 1px solid #ddd;"><%= pr.receiptNo %> <%= isCurrentReceipt ? '(Current)' : '' %></td>
                                            <td style="padding: 4px 6px; border: 1px solid #ddd;"><%= fmtDate(pr.paymentDate) %></td>
                                            <td style="padding: 4px 6px; border: 1px solid #ddd;"><%= pr.paymentMethod %></td>
                                            <td style="padding: 4px 6px; border: 1px solid #ddd; text-align: right; color: #0f2a24; font-weight: bold;">₹ <%= fmt(pr.amount) %></td>
                                            <td style="padding: 4px 6px; border: 1px solid #ddd; text-align: right; font-weight: bold; color: <%= runningBalance <= 0.01 ? 'green' : '#b91c1c' %>;">
                                                ₹ <%= fmt(runningBalance <= 0.01 ? 0 : runningBalance) %>
                                            </td>
                                        </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                            <% } %>
                        </td>
                        <td class="right" style="font-weight: bold; vertical-align: top;">₹ <%= fmt(invoiceTotal) %></td>
                        <td class="right amount-highlight; vertical-align: top;">₹ <%= fmt(receipt.amount) %></td>
                    </tr>
                    <tr>
                        <td colspan="2" class="right" style="font-weight: 600; font-size: 8.5pt; background-color: #fafafa;">Total Amount Received in this Payment</td>
                        <td class="right" style="font-weight: bold; font-size: 11pt; color: #0f2a24; background-color: #f7faf9;">₹ <%= fmt(receipt.amount) %></td>
                    </tr>
                    <tr>
                        <td colspan="2" class="right" style="font-weight: bold; font-size: 8.5pt; border: none; padding-top: 15px;">Remaining Invoice Balance Due</td>
                        <td class="right" style="font-weight: bold; font-size: 10pt; color: #b91c1c; border: none; padding-top: 15px;">₹ <%= fmt(balanceDue) %></td>
                    </tr>
                </tbody>
            </table>

            <!-- Words section -->
            <div class="words-section">
                <div class="words-label">Amount Received in Words</div>
                <div class="words-val"><%= numToWords(receipt.amount) %></div>
            </div>
        </div>

        <!-- BOTTOM SIGNATURE PANELS -->
        <div class="bottom-section">
            <div class="bottom-left">
                <div>
                    <strong>Payment Terms Note:</strong> This document serves as an official receipt of the payment specified above. Subject to Rajkot Jurisdiction. E&OE.
                </div>
            </div>
            <div class="bottom-right">
                <div style="font-weight: bold; font-size: 8.5pt; color: #0f2a24; text-transform: uppercase;">
                    For <%= settings?.companyName || 'Vegnar Global LLP' %>
                </div>
                <div class="sig-box">
                    Authorized Signatory
                </div>
            </div>
        </div>
    </div>

    <div class="footer">Thank you for your business.</div>
</div>
</body>
</html>
