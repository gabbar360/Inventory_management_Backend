<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Purchase Order - <%= po.poNo %></title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Roboto', sans-serif; font-size: 10pt; color: #333; background: #fff; }

        .page {
            width: 210mm;
            min-height: 297mm;
            margin: 0 auto;
            padding: 10mm 12mm;
            background: #fff;
        }

        .top-container { border: 1.5px solid #bbb; margin-bottom: 0; page-break-inside: avoid; }

        .header { display: flex; align-items: stretch; padding: 8px 10px; border-bottom: 1.5px solid #bbb; }

        .logo-block { width: 100px; display: flex; align-items: center; justify-content: flex-start; flex-shrink: 0; margin-right: 14px; }
        .logo-block img { max-width: 90px; max-height: 70px; object-fit: contain; }

        .company-block { flex: 1; }
        .company-name { font-size: 16pt; font-weight: 700; color: #222; line-height: 1.1; }
        .company-info { font-size: 8.5pt; color: #555; line-height: 1.5; margin-top: 3px; }

        .invoice-title-block { width: 200px; display: flex; align-items: flex-end; justify-content: flex-end; flex-shrink: 0; }
        .invoice-title-text { font-size: 18pt; font-weight: 700; color: #222; letter-spacing: 1px; text-align: right; white-space: nowrap; }

        .meta-row { display: flex; border-bottom: 1.5px solid #bbb; }
        .meta-left { flex: 1; border-right: 1.5px solid #bbb; padding: 8px 10px; }
        .meta-right { width: 260px; padding: 8px 10px; }

        .meta-table { width: 100%; border-collapse: collapse; }
        .meta-table td { padding: 2px 4px; font-size: 9.5pt; vertical-align: top; }
        .meta-table td:first-child { color: #666; white-space: nowrap; }
        .meta-table td:last-child { font-weight: 600; color: #222; }

        .party-row { display: flex; }
        .party-box { flex: 1; padding: 8px 10px; }
        .party-box:first-child { border-right: 1.5px solid #bbb; }
        .party-label { font-size: 9pt; color: #333; font-weight: 700; background: #e8e8e8; padding: 4px 10px; margin: -8px -10px 8px -10px; border-bottom: 1.5px solid #bbb; }
        .party-name { font-size: 11pt; font-weight: 700; color: #222; margin-bottom: 2px; }
        .party-addr { font-size: 9pt; color: #555; line-height: 1.5; }

        .items-table { width: 100%; border-collapse: collapse; margin-top: 8px; margin-bottom: 0; border: 1.5px solid #bbb; }
        .items-table thead { display: table-header-group; }
        .items-table thead tr { background: #f0f0f0; }
        .items-table th { padding: 6px 6px; font-size: 9pt; font-weight: 700; color: #444; text-align: center; border: 1px solid #bbb; }
        .items-table th.left { text-align: left; }
        .items-table td { padding: 5px 6px; font-size: 9.5pt; border: 1px solid #ddd; vertical-align: top; }
        .items-table td.center { text-align: center; }
        .items-table td.right { text-align: right; }
        .items-table tbody tr { page-break-inside: avoid; }

        .item-name { font-weight: 500; color: #222; }
        .item-desc { font-size: 8.5pt; color: #888; margin-top: 1px; }

        .text-bold { font-weight: bold; }

        .words-section {
            padding: 6px 10px;
            border: 1.5px solid #bbb;
            border-top: none;
            font-size: 9pt;
            background-color: #fafafa;
            page-break-inside: avoid;
        }
        .words-section span { font-weight: bold; }

        .gst-table-container { border: 1.5px solid #bbb; border-top: none; page-break-inside: avoid; }
        .gst-table { width: 100%; border-collapse: collapse; font-size: 8.5pt; }
        .gst-table th, .gst-table td { border: 1px solid #bbb; padding: 4px 6px; vertical-align: middle; }
        .gst-table th { background-color: #f0f0f0; font-weight: bold; text-align: center; }
        .gst-table td.center { text-align: center; }
        .gst-table td.right { text-align: right; }

        .invoice-bottom-container { display: flex; border: 1.5px solid #bbb; border-top: none; page-break-inside: avoid; }
        .bottom-left-panel {
            flex: 1.2; padding: 6px 10px; border-right: 1.5px solid #bbb;
            font-size: 8pt; display: flex; flex-direction: column; gap: 4px;
        }
        .bottom-right-panel {
            flex: 0.8; padding: 6px 10px; font-size: 8pt;
            display: flex; flex-direction: column; justify-content: space-between;
            align-items: stretch; min-height: 80px;
        }
        .terms-container {
            border: 1.5px solid #f87171;
            border-top: none;
            padding: 5px 9px;
            background: #fff8f8;
        }
        .terms-header {
            font-size: 7.8pt;
            font-weight: 700;
            color: #b91c1c;
            border-bottom: 1px solid #fecaca;
            padding-bottom: 2px;
            margin-bottom: 3px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }
        .terms-content {
            display: flex;
            flex-direction: column;
            gap: 2.5px;
        }
        .term-item {
            display: flex;
            align-items: flex-start;
            gap: 5px;
            font-size: 7.2pt;
            line-height: 1.35;
            color: #3f1d1d;
        }
        .term-subitem {
            padding-left: 15px;
        }
        .term-num {
            font-weight: 700;
            color: #dc2626;
            min-width: 15px;
            flex-shrink: 0;
            text-align: left;
            font-size: 7.2pt;
        }
        .term-sub-bullet {
            font-weight: 700;
            color: #ef4444;
            min-width: 10px;
            flex-shrink: 0;
            text-align: center;
            font-size: 7.2pt;
        }
        .term-key {
            font-weight: 700;
            color: #991b1b;
        }
        .term-text {
            flex: 1;
            word-break: break-word;
        }
        .panel-label { font-size: 8pt; font-weight: bold; color: #444; border-bottom: 1px solid #ddd; padding-bottom: 2px; margin-bottom: 3px; }

        .signatory-company { text-align: right; font-weight: bold; font-size: 8.5pt; margin-bottom: auto; padding-top: 2px; }
        .signatory-signatures { display: flex; justify-content: flex-end; align-items: flex-end; margin-top: auto; padding-bottom: 2px; }
        .sig-col { text-align: center; font-size: 7.5pt; width: 140px; border-top: 1px solid #bbb; padding-top: 3px; margin-left: auto; }

        .footer { margin-top: 10px; text-align: center; font-size: 7.5pt; color: #aaa; border-top: 1px solid #ccc; padding-top: 4px; page-break-inside: avoid; }

        @page { size: A4; margin: 8mm; }
        @media print {
            body { margin: 0; }
            .page { margin: 0; padding: 0; }
            .top-container { page-break-inside: avoid; }
            .items-table tbody tr { page-break-inside: avoid; }
            .words-section { page-break-inside: avoid; }
            .gst-table-container { page-break-inside: avoid; }
            .invoice-bottom-container { page-break-inside: avoid; }
            .terms-container { page-break-inside: avoid; }
        }
    </style>
</head>
<body>
<div class="page">
    <%
        function fmt(num) {
            if (num === undefined || num === null || isNaN(num)) return '0.00';
            return parseFloat(num).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
        function fmtDate(d) {
            if (!d) return '';
            return new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' });
        }

        function numToWords(n) {
            const ones = ['','One','Two','Three','Four','Five','Six','Seven','Eight','Nine'];
            const teens = ['Ten','Eleven','Twelve','Thirteen','Fourteen','Fifteen','Sixteen','Seventeen','Eighteen','Nineteen'];
            const tens = ['','','Twenty','Thirty','Forty','Fifty','Sixty','Seventy','Eighty','Ninety'];

            const h = (x) => {
                let r = '';
                if (x >= 100) { r += ones[Math.floor(x/100)] + ' Hundred '; x %= 100; }
                if (x >= 20) { r += tens[Math.floor(x/10)] + ' '; x %= 10; }
                else if (x >= 10) { r += teens[x-10] + ' '; x = 0; }
                if (x > 0) r += ones[x] + ' ';
                return r;
            };

            const convertInt = (num) => {
                if (num === 0) return 'Zero';
                let r = '';
                const cr = Math.floor(num/10000000); if (cr) { r += h(cr)+'Crore '; num %= 10000000; }
                const lk = Math.floor(num/100000); if (lk) { r += h(lk)+'Lakh '; num %= 100000; }
                const th = Math.floor(num/1000); if (th) { r += h(th)+'Thousand '; num %= 1000; }
                if (num > 0) r += h(num);
                return r.trim();
            };

            const fixedNum = parseFloat(n).toFixed(2);
            const parts = fixedNum.split('.');
            const rupees = parseInt(parts[0]);
            const paise = parseInt(parts[1]);
            let words = 'INR ' + convertInt(rupees);
            if (paise > 0) words += ' and ' + convertInt(paise) + ' Paise';
            return words + ' Only';
        }

        function formatTermsAndConditions(terms) {
            if (!terms || !terms.trim()) {
                return '<div class="term-item"><span class="term-num">1.</span><span class="term-text">Material must be supplied as per specifications and scheduled delivery timeline. Subject to Rajkot Jurisdiction "E&OE"</span></div>';
            }

            let raw = terms.trim();
            raw = raw.replace(/^\s*[\.\-•*]\s+([A-Za-z])/g, '$1');

            let rawParts = [];
            if (raw.includes('\n')) {
                rawParts = raw.split(/\r?\n/).map(s => s.trim()).filter(Boolean);
            } else {
                rawParts = raw.split(/(?=(?:^\s*\d+[\.\)]|\s+\d+[\.\)]|^\s*[\*\•\-]\s+|\s+[\*\•\-]\s+))/g)
                    .map(s => s.trim())
                    .filter(Boolean);
            }

            let cleanPoints = [];
            for (let i = 0; i < rawParts.length; i++) {
                let part = rawParts[i].replace(/^(\d+[\.\)]|[\*\•\-\.])\s*/, '').trim();
                if (!part) continue;

                if (part.length <= 45 && !part.includes(':') && !part.includes('.') && i + 1 < rawParts.length) {
                    let nextPart = rawParts[i + 1].replace(/^(\d+[\.\)]|[\*\•\-\.])\s*/, '').trim();
                    cleanPoints.push(`${part}: ${nextPart}`);
                    i++;
                } else {
                    cleanPoints.push(part);
                }
            }

            let html = '';
            let pointNumber = 1;

            cleanPoints.forEach((point) => {
                let text = point.trim();
                if (!text) return;

                text = text.replace(/\*{1,2}([^\*]+)\*{1,2}/g, '<span class="term-key">$1</span>');
                text = text.replace(/(?:^|(?<=>\s*))([^:<>\n]{2,50}):/g, '<span class="term-key">$1:</span>');

                html += `<div class="term-item">
                    <span class="term-num">${pointNumber++}.</span>
                    <span class="term-text">${text}</span>
                </div>`;
            });

            return html || `<div class="term-item"><span class="term-num">1.</span><span class="term-text">${raw}</span></div>`;
        }

        // Determine GST type (intra vs inter state)
        let sellerState = 'gujarat';
        if (settings?.companyAddress && settings.companyAddress.toLowerCase().includes('gujarat')) sellerState = 'gujarat';
        const vendorState = (po.vendor?.state || 'Gujarat').toLowerCase().trim();
        const isLocal = vendorState.includes(sellerState);

        let subTotal = 0, totalQty = 0, totalTax = 0;
        let hsnGroups = {};

        po.items?.forEach(item => {
            const hsn = item.product?.category?.hsnCode || 'N/A';
            const taxRate = item.taxRate || item.product?.category?.gstRate || 0;
            const displayRate = item.unit === 'piece' ? item.ratePerPcs : (item.unit === 'pack' ? item.ratePerPack : item.ratePerBox);
            const lineAmt = item.quantity * displayRate;
            const cgstRate = taxRate / 2;
            const cgstAmt = lineAmt * (cgstRate / 100);

            subTotal += lineAmt;
            totalQty += item.quantity;
            totalTax += (cgstAmt * 2);

            if (!hsnGroups[hsn]) {
                hsnGroups[hsn] = { hsn, taxableValue: 0, taxRate, cgstRate, cgstAmt: 0, sgstRate: cgstRate, sgstAmt: 0, igstRate: taxRate, igstAmt: 0, totalTax: 0 };
            }
            hsnGroups[hsn].taxableValue += lineAmt;
            hsnGroups[hsn].cgstAmt += cgstAmt;
            hsnGroups[hsn].sgstAmt += cgstAmt;
            hsnGroups[hsn].igstAmt += (cgstAmt * 2);
            hsnGroups[hsn].totalTax += (cgstAmt * 2);
        });

        const freight = po.shippingCharge || 0;
        const discount = po.discount || 0;

        const allTaxRates = po.items?.map(item => item.taxRate || item.product?.category?.gstRate || 0) || [];
        const shippingGstRate = allTaxRates.includes(18) ? 18 : (allTaxRates.includes(5) ? 5 : 0);
        const shippingGstAmt = freight > 0 ? freight * (shippingGstRate / 100) : 0;
        totalTax += shippingGstAmt;

        if (freight > 0 && shippingGstRate > 0) {
            const sacKey = '996511';
            const freightCgstRate = shippingGstRate / 2;
            const freightCgstAmt = shippingGstAmt / 2;
            if (!hsnGroups[sacKey]) {
                hsnGroups[sacKey] = { hsn: sacKey, taxableValue: 0, taxRate: shippingGstRate, cgstRate: freightCgstRate, cgstAmt: 0, sgstRate: freightCgstRate, sgstAmt: 0, igstRate: shippingGstRate, igstAmt: 0, totalTax: 0 };
            }
            hsnGroups[sacKey].taxableValue += freight;
            hsnGroups[sacKey].cgstAmt += freightCgstAmt;
            hsnGroups[sacKey].sgstAmt += freightCgstAmt;
            hsnGroups[sacKey].igstAmt += shippingGstAmt;
            hsnGroups[sacKey].totalTax += shippingGstAmt;
        }

        const grandTotal = Math.round(subTotal + totalTax + freight - discount);
        const companyGstin = settings?.companyGstin || '24ABAFV3901A1ZV';

        // Unit text
        let units = [];
        po.items?.forEach(item => {
            let u = item.unit || 'Pcs';
            u = u.charAt(0).toUpperCase() + u.slice(1);
            if (!units.includes(u)) units.push(u);
        });
        const unitText = units.length === 1 ? ' ' + units[0] : (units.length > 1 ? ' ' + units.join('/') : '');

        // Tax rate groups for inline rows
        let taxRateGroups = {};
        po.items?.forEach(item => {
            const taxRate = item.taxRate || item.product?.category?.gstRate || 0;
            const displayRate = item.unit === 'piece' ? item.ratePerPcs : (item.unit === 'pack' ? item.ratePerPack : item.ratePerBox);
            const lineAmt = item.quantity * displayRate;
            if (taxRate > 0) {
                const rateKey = taxRate.toFixed(2);
                const taxAmt = lineAmt * (taxRate / 100);
                if (!taxRateGroups[rateKey]) taxRateGroups[rateKey] = { rate: taxRate, amt: 0 };
                taxRateGroups[rateKey].amt += taxAmt;
            }
        });
        if (freight > 0 && shippingGstAmt > 0) {
            const rateKey = shippingGstRate.toFixed(2);
            if (!taxRateGroups[rateKey]) taxRateGroups[rateKey] = { rate: shippingGstRate, amt: 0 };
            taxRateGroups[rateKey].amt += shippingGstAmt;
        }
    %>

    <!-- HEADER -->
    <div class="top-container">
        <div class="header">
            <div class="logo-block">
                <% if (logoBase64) { %>
                    <img src="data:image/webp;base64,<%= logoBase64 %>" alt="Logo">
                <% } %>
            </div>
            <div class="company-block">
                <div class="company-name"><%= settings?.companyName || 'Vegnar Global LLP' %></div>
                <div class="company-info">
                    B-623, RK Iconic, 150 Feet Ring Road, Ayodhya Chowk<br>
                    Rajkot Gujarat 360007, India<br>
                    GSTIN: <%= companyGstin %><br>
                    <%= settings?.companyEmail || 'sales@vegnar.com' %> | <%= settings?.companyPhone || '+91 9998040482' %> | <%= settings?.companyWebsite || 'www.vegnar.com' %>
                </div>
            </div>
            <div class="invoice-title-block">
                <div class="invoice-title-text">Purchase Order</div>
            </div>
        </div>

        <!-- META -->
        <div class="meta-row">
            <div class="meta-left">
                <table class="meta-table">
                    <tr><td>Purchase Order #</td><td><%= po.poNo %></td></tr>
                    <tr><td>PO Date</td><td><%= fmtDate(po.poDate) %></td></tr>
                    <% if (po.expectedDelivery) { %><tr><td>Delivery Date</td><td><%= fmtDate(po.expectedDelivery) %></td></tr><% } %>
                    <% if (po.reference) { %><tr><td>Ref#</td><td><%= po.reference %></td></tr><% } %>
                </table>
            </div>
            <div class="meta-right">
                <table class="meta-table">
                    <% if (po.deliveryTerms) { %><tr><td>Shipment Terms</td><td><%= po.deliveryTerms %></td></tr><% } %>
                    <tr><td>Place Of Supply</td><td>Gujarat (24)</td></tr>
                </table>
            </div>
        </div>

        <!-- VENDOR / DELIVER TO -->
        <div class="party-row">
            <div class="party-box">
                <div class="party-label">Vendor Address</div>
                <div class="party-name"><%= po.vendor?.name || '' %></div>
                <div class="party-addr">
                    <%= po.vendor?.address || '' %><br>
                    <% if (po.vendor?.phone) { %>Phone: <%= po.vendor.phone %><br><% } %>
                    <% if (po.vendor?.email) { %>Email: <%= po.vendor.email %><br><% } %>
                    <% if (po.vendor?.gstNumber) { %>GSTIN: <%= po.vendor.gstNumber %><% } %>
                </div>
            </div>
            <div class="party-box">
                <div class="party-label">Deliver To</div>
                <div class="party-name"><%= settings?.companyName || 'Vegnar Global LLP' %></div>
                <div class="party-addr">
                    <% if (po.deliverToAddress) { %>
                        <%= po.deliverToAddress.replace(/\n/g, '<br>') %>
                    <% } else { %>
                        <%= settings?.companyAddress || '' %><br>
                        <% if (settings?.companyPhone) { %>Phone: <%= settings.companyPhone %><br><% } %>
                        <% if (settings?.companyEmail) { %>Email: <%= settings.companyEmail %><br><% } %>
                        GSTIN: <%= companyGstin %>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- ITEMS TABLE -->
    <table class="items-table">
        <thead>
            <tr>
                <th style="width:4%">SI No.</th>
                <th style="width:7%">SKU</th>
                <th class="left" style="width:29%">Description of Goods</th>
                <th style="width:10%">HSN/SAC</th>
                <th style="width:12%">Quantity</th>
                <th style="width:10%">Rate</th>
                <th style="width:8%">GST %</th>
                <th style="width:10%">GST Amt</th>
                <th style="width:10%">Amount</th>
            </tr>
        </thead>
        <tbody>
            <% po.items?.forEach((item, i) => {
                const displayRate = item.unit === 'piece' ? item.ratePerPcs : (item.unit === 'pack' ? item.ratePerPack : item.ratePerBox);
                const lineAmt = item.quantity * displayRate;
                const taxRate = item.taxRate || item.product?.category?.gstRate || 0;
                const lineTaxAmt = lineAmt * (taxRate / 100);
            %>
            <tr>
                <td class="center"><%= i + 1 %></td>
                <td class="center" style="white-space: nowrap;"><%= item.product?.sku || '-' %></td>
                <td>
                    <div class="item-name"><%= item.product?.name || 'Product' %></div>
                    <% if (item.description || item.product?.description) { %>
                    <div class="item-desc"><%= item.description || item.product?.description %></div>
                    <% } %>
                </td>
                <td class="center" style="white-space: nowrap;"><%= item.product?.category?.hsnCode || '' %></td>
                <td class="right" style="font-weight: bold; white-space: nowrap;"><%= item.quantity.toLocaleString('en-IN') %> <%= item.unit || 'Pcs' %></td>
                <td class="right" style="white-space: nowrap;"><%= fmt(displayRate) %></td>
                <td class="center" style="font-weight: bold; white-space: nowrap;"><%= taxRate %>%</td>
                <td class="right" style="font-weight: bold; white-space: nowrap;"><%= fmt(lineTaxAmt) %></td>
                <td class="right" style="font-weight: bold; white-space: nowrap;"><%= fmt(lineAmt) %></td>
            </tr>
            <% }) %>

            <!-- Sub Total -->
            <tr>
                <td colspan="4" style="border-top: 1px solid #bbb; border-right: none; border-bottom: none;"></td>
                <td colspan="4" class="right" style="font-weight: bold; border: 1px solid #bbb; border-left: none; border-bottom: none; font-size: 9.5pt; white-space: nowrap;">Sub Total</td>
                <td class="right" style="font-weight: bold; border-top: 1.5px solid #bbb; border-bottom: none; white-space: nowrap;"><%= fmt(subTotal) %></td>
            </tr>

            <% if (freight > 0) { %>
            <tr>
                <td colspan="4" style="border-top: none; border-bottom: none; border-right: none;"></td>
                <td colspan="4" class="right" style="border-top: none; border-bottom: none; border-left: none; border-right: 1px solid #bbb; font-weight: bold; white-space: nowrap;">Freight / Shipping</td>
                <td class="right" style="border-top: none; border-bottom: none; font-weight: bold; white-space: nowrap;"><%= fmt(freight) %></td>
            </tr>
            <% } %>

            <% Object.keys(taxRateGroups).forEach(rateKey => {
                const group = taxRateGroups[rateKey];
                if (isLocal) {
                    const halfRate = (group.rate / 2).toFixed(2);
                    const halfAmt = group.amt / 2;
            %>
            <tr>
                <td colspan="4" style="border-top: none; border-bottom: none; border-right: none;"></td>
                <td colspan="3" class="right" style="border-top: none; border-bottom: none; border-left: none; border-right: none; font-weight: bold; white-space: nowrap;">CGST</td>
                <td class="center" style="border-top: none; border-bottom: none; border-left: none; border-right: 1px solid #bbb; font-weight: bold; white-space: nowrap;"><%= parseFloat(halfRate).toFixed(2) %>%</td>
                <td class="right" style="border-top: none; border-bottom: none; font-weight: bold; white-space: nowrap;"><%= fmt(halfAmt) %></td>
            </tr>
            <tr>
                <td colspan="4" style="border-top: none; border-bottom: none; border-right: none;"></td>
                <td colspan="3" class="right" style="border-top: none; border-bottom: none; border-left: none; border-right: none; font-weight: bold; white-space: nowrap;">SGST</td>
                <td class="center" style="border-top: none; border-bottom: none; border-left: none; border-right: 1px solid #bbb; font-weight: bold; white-space: nowrap;"><%= parseFloat(halfRate).toFixed(2) %>%</td>
                <td class="right" style="border-top: none; border-bottom: none; font-weight: bold; white-space: nowrap;"><%= fmt(halfAmt) %></td>
            </tr>
            <% } else { %>
            <tr>
                <td colspan="4" style="border-top: none; border-bottom: none; border-right: none;"></td>
                <td colspan="3" class="right" style="border-top: none; border-bottom: none; border-left: none; border-right: none; font-weight: bold; white-space: nowrap;">IGST</td>
                <td class="center" style="border-top: none; border-bottom: none; border-left: none; border-right: 1px solid #bbb; font-weight: bold; white-space: nowrap;"><%= parseFloat(group.rate).toFixed(2) %>%</td>
                <td class="right" style="border-top: none; border-bottom: none; font-weight: bold; white-space: nowrap;"><%= fmt(group.amt) %></td>
            </tr>
            <% } }); %>

            <% if (discount > 0) { %>
            <tr>
                <td colspan="4" style="border-top: none; border-bottom: none; border-right: none;"></td>
                <td colspan="4" class="right" style="border-top: none; border-bottom: none; border-left: none; border-right: 1px solid #bbb; font-weight: bold; color: red; white-space: nowrap;">Discount</td>
                <td class="right" style="border-top: none; border-bottom: none; font-weight: bold; color: red; white-space: nowrap;">-<%= fmt(discount) %></td>
            </tr>
            <% } %>

            <!-- Total Row -->
            <tr style="border-top: 1.5px solid #bbb; border-bottom: 1.5px solid #bbb; background-color: #fcfcfc;">
                <td colspan="4" class="right" style="font-weight: bold; text-align: right; border-bottom: 1.5px solid #bbb; white-space: nowrap;">Total</td>
                <td class="right" style="font-weight: bold; border-bottom: 1.5px solid #bbb; white-space: nowrap;"><%= totalQty.toLocaleString('en-IN') %><%= unitText %></td>
                <td colspan="3" style="border-left: none; border-right: 1px solid #bbb; border-bottom: 1.5px solid #bbb;"></td>
                <td class="right" style="font-weight: bold; border-bottom: 1.5px solid #bbb; white-space: nowrap;">₹ <%= fmt(grandTotal) %></td>
            </tr>
        </tbody>
    </table>

    <!-- Amount in words -->
    <div class="words-section">
        Amount Chargeable (in words): <span><%= numToWords(grandTotal) %></span>
    </div>

    <!-- HSN/SAC GST Table -->
    <div class="gst-table-container">
        <table class="gst-table">
            <thead>
                <% if (isLocal) { %>
                <tr>
                    <th rowspan="2" style="width: 25%;">HSN/SAC</th>
                    <th rowspan="2" style="width: 15%;">Taxable<br>Value</th>
                    <th colspan="2" style="width: 20%;">CGST</th>
                    <th colspan="2" style="width: 20%;">SGST/UTGST</th>
                    <th rowspan="2" style="width: 20%;">Total<br>Tax Amount</th>
                </tr>
                <tr><th>Rate</th><th>Amount</th><th>Rate</th><th>Amount</th></tr>
                <% } else { %>
                <tr>
                    <th rowspan="2" style="width: 30%;">HSN/SAC</th>
                    <th rowspan="2" style="width: 20%;">Taxable<br>Value</th>
                    <th colspan="2" style="width: 30%;">IGST</th>
                    <th rowspan="2" style="width: 20%;">Total<br>Tax Amount</th>
                </tr>
                <tr><th>Rate</th><th>Amount</th></tr>
                <% } %>
            </thead>
            <tbody>
                <%
                    let totalTaxable = 0, totalCgst = 0, totalSgst = 0, totalIgst = 0, totalTaxAmt = 0;
                    Object.values(hsnGroups).forEach(group => {
                        totalTaxable += group.taxableValue;
                        totalCgst += group.cgstAmt;
                        totalSgst += group.sgstAmt;
                        totalIgst += group.igstAmt;
                        totalTaxAmt += group.totalTax;
                %>
                <tr>
                    <td class="center"><%= group.hsn %></td>
                    <td class="right"><%= fmt(group.taxableValue) %></td>
                    <% if (isLocal) { %>
                    <td class="center"><%= group.cgstRate.toFixed(2) %>%</td>
                    <td class="right"><%= fmt(group.cgstAmt) %></td>
                    <td class="center"><%= group.sgstRate.toFixed(2) %>%</td>
                    <td class="right"><%= fmt(group.sgstAmt) %></td>
                    <% } else { %>
                    <td class="center"><%= group.igstRate.toFixed(2) %>%</td>
                    <td class="right"><%= fmt(group.igstAmt) %></td>
                    <% } %>
                    <td class="right text-bold"><%= fmt(group.totalTax) %></td>
                </tr>
                <% }) %>
                <tr style="font-weight: bold; background-color: #fafafa;">
                    <td class="right text-bold">Total</td>
                    <td class="right text-bold"><%= fmt(totalTaxable) %></td>
                    <% if (isLocal) { %>
                    <td class="center"></td><td class="right text-bold"><%= fmt(totalCgst) %></td>
                    <td class="center"></td><td class="right text-bold"><%= fmt(totalSgst) %></td>
                    <% } else { %>
                    <td class="center"></td><td class="right text-bold"><%= fmt(totalIgst) %></td>
                    <% } %>
                    <td class="right text-bold"><%= fmt(totalTaxAmt) %></td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Tax Amount in words -->
    <div class="words-section" style="border-bottom: 1.5px solid #bbb;">
        Tax Amount (in words): <span><%= numToWords(totalTax) %></span>
    </div>

    <!-- BOTTOM PANELS -->
    <div class="invoice-bottom-container">
        <div class="bottom-left-panel">
            <div>
                <div class="panel-label">Delivery & Order Info</div>
                <div style="font-size: 7.5pt; color: #333; line-height: 1.35;">
                    <% if (po.deliveryAddress) { %>
                        <span class="text-bold">Delivery Address:</span> <%= po.deliveryAddress %><br>
                    <% } %>
                    <% if (po.expectedDeliveryDate) { %>
                        <span class="text-bold">Expected Delivery:</span> <%= fmtDate(po.expectedDeliveryDate) %><br>
                    <% } %>
                    <span class="text-bold">PO Reference:</span> <%= po.poNo %>
                </div>
            </div>
        </div>

        <div class="bottom-right-panel">
            <div class="signatory-company">for <%= settings?.companyName || 'VEGNAR GLOBAL LLP' %></div>
            <div class="signatory-signatures">
                <div class="sig-col">Authorised Signatory</div>
            </div>
        </div>
    </div>

    <!-- FULL WIDTH TERMS & CONDITIONS (LIGHT RED HIGHLIGHTED) -->
    <div class="terms-container">
        <div class="terms-header">Terms & Conditions</div>
        <div class="terms-content">
            <%- formatTermsAndConditions(po.notes) %>
        </div>
    </div>

    <div class="footer">This is a Computer Generated Purchase Order</div>
</div>
</body>
</html>
