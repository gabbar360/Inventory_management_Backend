<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Vendor Ledger - <%= ledger.vendor.name %></title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; font-size: 9pt; color: #374151; background: #fff; line-height: 1.4; }

        .page {
            width: 210mm;
            min-height: 297mm;
            margin: 0 auto;
            padding: 15mm;
            background: #fff;
        }

        .header-section {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }

        .company-details {
            max-width: 60%;
        }

        .logo-container {
            margin-bottom: 10px;
        }
        .logo-container img {
            max-height: 45px;
            max-width: 160px;
            object-fit: contain;
        }

        .company-name {
            font-size: 13pt;
            font-weight: 700;
            color: #111827;
            margin-bottom: 3px;
        }

        .company-info {
            font-size: 8pt;
            color: #4b5563;
            line-height: 1.4;
        }

        .report-title-container {
            text-align: right;
        }

        .report-title {
            font-size: 18pt;
            font-weight: 700;
            color: #e25822; /* Zoho Books signature Orange */
            letter-spacing: -0.5px;
            margin-bottom: 5px;
            text-transform: uppercase;
        }

        .report-period {
            font-size: 8.5pt;
            color: #6b7280;
            font-weight: 500;
        }

        .details-grid {
            display: flex;
            justify-content: space-between;
            margin-bottom: 25px;
        }

        .billing-to {
            width: 50%;
        }

        .section-label {
            font-size: 8pt;
            font-weight: 600;
            color: #9ca3af;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 6px;
            display: block;
        }

        .party-name {
            font-size: 10pt;
            font-weight: 700;
            color: #111827;
            margin-bottom: 3px;
        }

        .party-addr {
            font-size: 8.5pt;
            color: #4b5563;
            line-height: 1.4;
        }

        .summary-card {
            width: 45%;
            background-color: #fdf5f2; /* Styled tint */
            border-left: 4px solid #e25822;
            padding: 12px 16px;
            border-radius: 4px;
        }

        .summary-table {
            width: 100%;
            border-collapse: collapse;
        }
        .summary-table td {
            padding: 3px 0;
            font-size: 8.5pt;
        }
        .summary-table td.label {
            color: #6b7280;
        }
        .summary-table td.value {
            font-weight: 600;
            color: #111827;
            text-align: right;
        }
        .summary-table tr.highlight td.label {
            font-weight: 700;
            color: #111827;
            padding-top: 6px;
            border-top: 1px solid #ffdcd0;
        }
        .summary-table tr.highlight td.value {
            font-weight: 700;
            color: #e25822;
            padding-top: 6px;
            border-top: 1px solid #ffdcd0;
        }

        .items-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 25px;
        }

        .items-table th {
            padding: 8px 10px;
            font-size: 8pt;
            font-weight: 650;
            color: #4b5563;
            text-transform: uppercase;
            border-bottom: 2px solid #e5e7eb;
            background-color: #f9fafb;
        }
        
        .items-table td {
            padding: 8px 10px;
            font-size: 8.5pt;
            color: #374151;
            border-bottom: 1px solid #e5e7eb;
            vertical-align: middle;
        }

        .items-table tr.opening-row td {
            background-color: #fafbfc;
            font-weight: 600;
            color: #4b5563;
            border-bottom: 1px solid #d1d5db;
        }

        .items-table tr.closing-row td {
            font-weight: 750;
            color: #111827;
            background-color: #f9fafb;
            border-top: 1.5px solid #d1d5db;
            border-bottom: 2px double #9ca3af;
        }

        .text-left { text-align: left; }
        .text-right { text-align: right; }
        .text-center { text-align: center; }

        .footer {
            margin-top: 40px;
            text-align: center;
            font-size: 8pt;
            color: #9ca3af;
            border-top: 1px solid #f3f4f6;
            padding-top: 10px;
        }

        @page { size: A4; margin: 0; }
        @media print {
            body { margin: 0; }
            .page { padding: 10mm; }
        }
    </style>
</head>
<body>
<div class="page">
    <%
        function fmt(num) {
            if (num === undefined || num === null || isNaN(num)) return '0.00';
            return parseFloat(num).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
        function fmtBalance(num) {
            if (num === undefined || num === null || isNaN(num)) return '0.00';
            const absVal = Math.abs(num);
            const formatted = parseFloat(absVal).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            if (num > 0) {
                return formatted + ' Cr';
            } else if (num < 0) {
                return formatted + ' Dr';
            }
            return formatted;
        }
        function fmtDate(d) {
            if (!d) return '';
            return new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' });
        }
    %>

    <!-- HEADER SECTION -->
    <div class="header-section">
        <div class="company-details">
            <div class="logo-container">
                <% if (logoBase64) { %>
                    <img src="data:image/webp;base64,<%= logoBase64 %>" alt="Logo">
                <% } %>
            </div>
            <div class="company-name"><%= settings?.companyName || 'Vegnar Global LLP' %></div>
            <div class="company-info">
                <%= settings?.companyAddress || 'B-623, RK Iconic, 150 Feet Ring Road, Ayodhya Chowk, Rajkot Gujarat 360007, India' %><br>
                GSTIN: <%= settings?.companyGstin || '24ABAFV3901A1ZV' %><br>
                Email: <%= settings?.companyEmail || 'sales@vegnar.com' %> | Phone: <%= settings?.companyPhone || '+91 9998040482' %>
            </div>
        </div>
        <div class="report-title-container">
            <div class="report-title">Vendor Ledger</div>
            <div class="report-period">
                <% if (startDate && endDate) { %>
                    Period: <%= fmtDate(startDate) %> to <%= fmtDate(endDate) %>
                <% } else if (startDate) { %>
                    From: <%= fmtDate(startDate) %>
                <% } else if (endDate) { %>
                    To: <%= fmtDate(endDate) %>
                <% } else { %>
                    All Time Statement
                <% } %>
            </div>
        </div>
    </div>

    <!-- DETAILS GRID -->
    <div class="details-grid">
        <div class="billing-to">
            <span class="section-label">Statement For</span>
            <div class="party-name"><%= ledger.vendor.name %></div>
            <div class="party-addr">
                Vendor Code: <%= ledger.vendor.code %><br>
                <%= ledger.vendor.address || '' %><br>
                <% if (ledger.vendor.phone) { %>Phone: <%= ledger.vendor.phone %><br><% } %>
                <% if (ledger.vendor.email) { %>Email: <%= ledger.vendor.email %><br><% } %>
                <% if (ledger.vendor.gstNumber) { %>GSTIN: <%= ledger.vendor.gstNumber %><% } %>
            </div>
        </div>
        <div class="summary-card">
            <span class="section-label">Account Summary</span>
            <table class="summary-table">
                <tr>
                    <td class="label">Opening Balance:</td>
                    <td class="value">₹ <%= fmtBalance(ledger.openingBalance) %></td>
                </tr>
                <tr>
                    <td class="label">Total Bills (Purchases):</td>
                    <td class="value">₹ <%= fmt(ledger.totalCredit) %></td>
                </tr>
                <tr>
                    <td class="label">Total Payments Made:</td>
                    <td class="value">₹ <%= fmt(ledger.totalDebit) %></td>
                </tr>
                <tr class="highlight">
                    <td class="label">Net Balance Payable:</td>
                    <td class="value">₹ <%= fmtBalance(ledger.closingBalance) %></td>
                </tr>
            </table>
        </div>
    </div>

    <!-- TRANSACTION TABLE -->
    <table class="items-table">
        <thead>
            <tr>
                <th class="text-center" style="width: 12%">Date</th>
                <th class="text-left" style="width: 18%">Transaction #</th>
                <th class="text-left" style="width: 15%">Type</th>
                <th class="text-left" style="width: 25%">Details</th>
                <th class="text-right" style="width: 15%">Debit (Paid)</th>
                <th class="text-right" style="width: 15%">Credit (Billed)</th>
                <th class="text-right" style="width: 15%">Balance</th>
            </tr>
        </thead>
        <tbody>
            <!-- Opening Balance Row -->
            <tr class="opening-row">
                <td class="text-center"><%= startDate ? fmtDate(startDate) : '—' %></td>
                <td class="text-left">Opening Balance</td>
                <td class="text-left">—</td>
                <td class="text-left">Statement Start Balance</td>
                <td class="text-right">—</td>
                <td class="text-right">—</td>
                <td class="text-right">₹ <%= fmtBalance(ledger.openingBalance) %></td>
            </tr>

            <% if (ledger.transactions && ledger.transactions.length > 0) { %>
                <% ledger.transactions.forEach((tx) => { %>
                <tr>
                    <td class="text-center"><%= fmtDate(tx.date) %></td>
                    <td class="text-left" style="font-weight: 500;"><%= tx.refNo %></td>
                    <td class="text-left"><%= tx.type %></td>
                    <td class="text-left" style="font-size: 8pt; color: #555;"><%= tx.details %></td>
                    <td class="text-right text-red-600"><%= tx.debit > 0 ? '₹ ' + fmt(tx.debit) : '—' %></td>
                    <td class="text-right text-emerald-600"><%= tx.credit > 0 ? '₹ ' + fmt(tx.credit) : '—' %></td>
                    <td class="text-right" style="font-weight: 600;">₹ <%= fmtBalance(tx.balance) %></td>
                </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="7" class="text-center" style="padding: 15px; color: #9ca3af;">
                        No transactions recorded in this period.
                    </td>
                </tr>
            <% } %>

            <!-- Closing Balance Row -->
            <tr class="closing-row">
                <td class="text-center"><%= endDate ? fmtDate(endDate) : '—' %></td>
                <td class="text-left">Closing Balance</td>
                <td class="text-left">—</td>
                <td class="text-left">Net Outstanding Balance</td>
                <td class="text-right">₹ <%= fmt(ledger.totalDebit) %></td>
                <td class="text-right">₹ <%= fmt(ledger.totalCredit) %></td>
                <td class="text-right">₹ <%= fmtBalance(ledger.closingBalance) %></td>
            </tr>
        </tbody>
    </table>

    <!-- FOOTER -->
    <div class="footer">
        This is a computer generated ledger report. Powered by Vegnar ERP.
    </div>
</div>
</body>
</html>
